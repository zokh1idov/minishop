# Токен бота от @BotFather. НИКОГДА не коммитить и не отдавать на клиент.
BOT_TOKEN=123456:ABC-your-token

# Публичный HTTPS-адрес приложения (ngrok / cloudflared / хостинг)
APP_URL=https://example.ngrok-free.app

# Username бота (без @) и короткое имя Mini App из /newapp — для ссылок t.me/<bot>/<app>
BOT_USERNAME=my_shop_bot
APP_NAME=shop

PORT=3000
CURRENCY=USD

# Максимальный возраст initData в секундах (проверка auth_date)
INIT_DATA_MAX_AGE=3600

# Только для локальной отладки в обычном браузере (без Telegram). В проде = 0!
DEV_BYPASS=0

# 1 = бот отвечает на /start кнопкой «Открыть магазин» (long polling)
BOT_POLLING=0
